{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kilntrace/schemas/kiln_record.schema.json",
  "title": "KilnTrace kiln record v1 (FROZEN)",
  "description": "One kiln observed in one run. Hashed as canonical JSON (sorted keys, no spaces). No floats anywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "runId", "kilnId", "h3", "centroid_e6", "polygon_e6", "areaM2", "class",
    "confidenceBp", "state", "prevState", "riskScore", "thermalDtCk", "inBanWindow",
    "sceneDate", "chipSha256", "chipCID", "modelSha256"
  ],
  "$defs": {
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lonLatE6": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -180000000, "maximum": 180000000 },
        { "type": "integer", "minimum": -90000000, "maximum": 90000000 }
      ],
      "items": false,
      "minItems": 2
    },
    "state": { "enum": ["NEW", "NON_ZIGZAG", "ZIGZAG", "CONVERTED", "NOT_SEEN", "REAPPEARED"] }
  },
  "properties": {
    "schema": { "const": "kilntrace.record.v1" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "kilnId": { "type": "string", "pattern": "^0x[0-9a-f]{64}$", "description": "keccak256('KT1:' + h3 cell), fixed at first sighting" },
    "h3": { "type": "string", "pattern": "^[0-9a-f]{15}$", "description": "H3 cell, resolution 10" },
    "centroid_e6": { "$ref": "#/$defs/lonLatE6", "description": "[lon, lat] x 1e6" },
    "polygon_e6": {
      "type": "array",
      "items": { "$ref": "#/$defs/lonLatE6" },
      "minItems": 4,
      "maxItems": 4,
      "description": "Oriented box corners [lon, lat] x 1e6, not closed"
    },
    "areaM2": { "type": "integer", "minimum": 0 },
    "class": { "enum": ["CFCBK", "FCBK", "Zigzag"] },
    "confidenceBp": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "state": { "$ref": "#/$defs/state" },
    "prevState": { "oneOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }], "description": "null at first sighting" },
    "riskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "thermalDtCk": { "type": ["integer", "null"], "description": "centi-kelvin; null when no Landsat pass" },
    "inBanWindow": { "type": "boolean" },
    "sceneDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "chipSha256": { "$ref": "#/$defs/hex32" },
    "chipCID": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,128}(/[A-Za-z0-9._-]{1,64})?$", "description": "IPFS CID, or folderCID/file.png" },
    "modelSha256": { "$ref": "#/$defs/hex32" }
  }
}
